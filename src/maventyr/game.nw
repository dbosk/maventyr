def test_a_scripted_sequence_drives_a_headless_game():
    world = _StubWorld()
    transcript = Engine(world).run(["titta", "gå norr", "sluta", "titta"])
    assert transcript == [
        Message(WELCOME["sv"]),
        *world.look("sv"),
        *world.look("sv"),
        *world.move("norr", "sv"),
