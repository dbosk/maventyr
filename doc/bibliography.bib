% --- Maze generation (depth-first search) --------------------------------
% Ground the labyrinth generator (Maps chapter): the recursive backtracker is
% a randomized depth-first search.  Trémaux's 19th-century maze procedure
% (recorded by Lucas) is the original DFS; Tarjan gave its canonical graph
% formalization; Knuth treats the spanning trees a perfect maze is an instance
% of.

@book{lucas1882recreations,
  author    = {Lucas, Édouard},
  title     = {Récréations mathématiques},
  year      = {1882},
  volume    = {1},
  publisher = {Gauthier-Villars},
  address   = {Paris},
  note      = {Records Trémaux's maze-traversal algorithm, an early
               depth-first search},
}

@article{tarjan1972dfs,
  author  = {Tarjan, Robert E.},
  title   = {Depth-first search and linear graph algorithms},
  journal = {SIAM Journal on Computing},
  year    = {1972},
  volume  = {1},
  number  = {2},
  pages   = {146--160},
  doi     = {10.1137/0201010},
}

